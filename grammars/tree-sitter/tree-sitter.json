{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tsrx",
      "camelcase": "Tsrx",
      "title": "TSRX",
      "scope": "source.tsrx",
      "file-types": ["tsrx"],
      "injection-regex": "^tsrx$",
      "class-name": "TreeSitterTsrx"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "TSRX grammar for tree-sitter",
    "authors": [
      {
        "name": "TSRX"
      }
    ],
    "links": {
      "repository": "https://github.com/tsrx-org/tsrx/tree/main/grammars/tree-sitter"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
